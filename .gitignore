# Local research notes (operator directive: never committed)
/research/

# Local agent memory (operator directive: never committed)
/AGENTS.md

# Generated evidence bundles (the receipts they contain are committed)
/bench/bundles/

# Build outputs
/target/
**/target/
/.docker-cache/
**/.gocache/
**/bin/
*.profraw
*.profdata

# Python build artifacts (the wheel is attached to releases, not committed)
/python/dist/
/python/build/
/python/*.egg-info/
**/__pycache__/
/python/.pytest_cache/

# Runtime mount points and scratch
/mnt-test/
/tmp/
*.tmp
*.swp

# OS noise
.DS_Store

# Rust source binary targets (not build output; build output is target/)
!/src/bin/
!/src/bin/**
